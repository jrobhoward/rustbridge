{erl_opts, [debug_info]}.
{deps, []}.

{pre_hooks, [
    {"(linux|darwin|solaris|freebsd)", compile,
     "sh -c 'cargo build --release -p rustbridge-port-driver --manifest-path ../Cargo.toml && "
     "mkdir -p priv && "
     "cp ../target/release/rustbridge-port-driver priv/rustbridge-port-driver'"}
]}.

{profiles, [
    {test, [
        {pre_hooks, [
            {"(linux|darwin|solaris|freebsd)", compile,
             "sh -c 'cargo build --release -p rustbridge-port-driver --manifest-path ../Cargo.toml && "
             "cargo build --release -p hello-plugin --manifest-path ../Cargo.toml && "
             "mkdir -p priv && "
             "cp ../target/release/rustbridge-port-driver priv/rustbridge-port-driver'"}
        ]}
    ]}
]}.

{ct_opts, [{dir, "test"}]}.
{eunit_opts, [verbose]}.

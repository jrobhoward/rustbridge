<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>{{class-name}}</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="RustBridge.Core" Version="1.0.1" />
    <PackageReference Include="RustBridge.Native" Version="1.0.1" />
  </ItemGroup>

  <!-- For local development against rustbridge source, replace PackageReference
       with ProjectReference. See docs/DEVELOPMENT.md for details.
  <ItemGroup>
    <ProjectReference Include="/path/to/rustbridge/rustbridge-csharp/RustBridge.Core/RustBridge.Core.csproj" />
    <ProjectReference Include="/path/to/rustbridge/rustbridge-csharp/RustBridge.Native/RustBridge.Native.csproj" />
  </ItemGroup>
  -->

</Project>

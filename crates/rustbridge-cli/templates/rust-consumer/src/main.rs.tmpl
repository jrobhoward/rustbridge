//! {{project-name}} - Rust consumer for rustbridge plugin

use rustbridge_consumer::{ConsumerResult, NativePluginLoader, PluginConfig};
use serde::{Deserialize, Serialize};

// Define your request/response types to match your plugin's API
#[derive(Debug, Serialize)]
struct EchoRequest {
    message: String,
}

#[derive(Debug, Deserialize)]
struct EchoResponse {
    message: String,
    length: usize,
}

fn main() -> ConsumerResult<()> {
    // Update this path to your .rbp bundle file
    let bundle_path = "{{bundle-path}}";

    // Load the plugin from a bundle
    let config = PluginConfig::default();
    let plugin = NativePluginLoader::load_bundle_with_config(bundle_path, &config, None)?;

    // Example: Call the "echo" message type
    let request = EchoRequest {
        message: "Hello from Rust!".to_string(),
    };

    let response: EchoResponse = plugin.call_typed("echo", &request)?;

    println!("Response: {}", response.message);
    println!("Length: {}", response.length);

    // Shutdown (optional - Drop also handles this)
    plugin.shutdown()?;

    Ok(())
}

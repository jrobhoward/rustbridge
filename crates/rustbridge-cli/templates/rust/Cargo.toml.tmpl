[package]
name = "{{project-name}}"
version = "0.1.0"
edition = "2021"

[workspace]  # Standalone project (not part of a parent workspace)

[lib]
crate-type = ["cdylib"]

[dependencies]
rustbridge = "0.8"

# Serde is needed as a direct dependency because derive macros expand to
# code that references ::serde:: directly
serde = { version = "1.0", features = ["derive"] }

[dev-dependencies]
tokio = { version = "1.35", features = ["rt", "macros"] }

# Uncomment to auto-include schemas when running `rustbridge pack`:
# [package.metadata.rustbridge]
# schema-source = "src/lib.rs:schema.json"
# header-source = "src/binary_messages.rs:messages.h"
